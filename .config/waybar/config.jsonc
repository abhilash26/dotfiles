{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,
  "margin-top": 4,
  "margin-left": 8,
  "margin-right": 8,
  "fixed-center": true,

  "modules-left": [
    "ext/workspaces",
  ],
  "modules-center": [
    "power-profiles-daemon",
    "clock",
    "idle_inhibitor",
  ],
  "modules-right": [
    "backlight",
    "wireplumber",
    "network",
    "battery",
    "tray"
  ],

  "ext/workspaces": {
    "format": "{icon}",
    "hide-empty": true,
    "on-click": "activate",
    "on-click-right": "toggle",
    "tooltip": false
  },

  "clock": {
    "format": " {:%a %d %b %I:%M %p}",
    "interval": 60,
    "tooltip": false
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "tooltip": false,
    "smooth-scrolling-threshold": 5
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": [
      "󰕿",
      "󰖀",
      "󰕾"
    ],
    "tooltip": false,
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 wired",
    "format-disconnected": "󰤭 offline",
    "tooltip": false,
    "on-click": "nm-applet"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": "󰒲"
    },
    "tooltip-format-activated": "Idle sleep inhibited",
    "tooltip-format-deactivated": "Idle inhibitor off"
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}",
    "format-icons": {
      "default": "󰌪",
      "power-saver": "󰌪",
      "balanced": "󰗑",
      "performance": "󱓞"
    }
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "tooltip": false
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
}
